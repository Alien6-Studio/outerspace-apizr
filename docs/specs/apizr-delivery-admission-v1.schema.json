{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "apizr.delivery-admission/v1",
      "default": "apizr.delivery-admission/v1",
      "title": "Schema",
      "type": "string"
    },
    "state": {
      "default": "admitted",
      "enum": [
        "admitted",
        "remote_state_unconfirmed"
      ],
      "title": "State",
      "type": "string"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "image_reference": {
      "title": "Image Reference",
      "type": "string"
    },
    "delivery_plan_digest": {
      "$ref": "#/$defs/Digest"
    },
    "delivery_manifest_digest": {
      "$ref": "#/$defs/Digest"
    },
    "proof_artifact_reference": {
      "title": "Proof Artifact Reference",
      "type": "string"
    },
    "proof_artifact_manifest_digest": {
      "title": "Proof Artifact Manifest Digest",
      "type": "string"
    },
    "receipt_sha256": {
      "title": "Receipt Sha256",
      "type": "string"
    },
    "signer": {
      "title": "Signer",
      "type": "string"
    },
    "transfer_verified": {
      "const": true,
      "default": true,
      "title": "Transfer Verified",
      "type": "boolean"
    },
    "destination_promoted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": true,
      "title": "Destination Promoted"
    },
    "delivery_admitted": {
      "default": true,
      "title": "Delivery Admitted",
      "type": "boolean"
    }
  },
  "required": [
    "destination",
    "image_reference",
    "delivery_plan_digest",
    "delivery_manifest_digest",
    "proof_artifact_reference",
    "proof_artifact_manifest_digest",
    "receipt_sha256",
    "signer"
  ],
  "title": "AdmissionResult",
  "type": "object"
}
