{
  "$defs": {
    "HistoryQuery": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "anyOf": [
            {
              "enum": [
                "success",
                "failed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "capability": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "limit": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "HistoryQuery",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "apizr.experiment-run-result/v1",
          "default": "apizr.experiment-run-result/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "run_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Digest",
          "type": "string"
        },
        "plan_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Digest",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "metrics": {
          "maximum": 256,
          "minimum": 0,
          "title": "Metrics",
          "type": "integer"
        },
        "outputs": {
          "maximum": 256,
          "minimum": 0,
          "title": "Outputs",
          "type": "integer"
        }
      },
      "required": [
        "run_digest",
        "plan_digest",
        "status",
        "source",
        "started_at",
        "metrics",
        "outputs"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "python",
            "notebook"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "executable_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Digest"
        },
        "module": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "capability_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\s/\\\\]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        }
      },
      "required": [
        "kind",
        "reference",
        "digest"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "apizr.experiment-history/v1",
      "default": "apizr.experiment-history/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/HistoryQuery"
    },
    "total": {
      "maximum": 4096,
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "matched": {
      "maximum": 4096,
      "minimum": 0,
      "title": "Matched",
      "type": "integer"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunSummary"
      },
      "maxItems": 1000,
      "title": "Runs",
      "type": "array"
    }
  },
  "required": [
    "query",
    "total",
    "matched",
    "runs"
  ],
  "title": "HistoryList",
  "type": "object"
}
