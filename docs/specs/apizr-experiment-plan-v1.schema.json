    "inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InputArtifact"
      },
      "maxItems": 256,
      "title": "Inputs",
      "type": "array"
    },
    "parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Parameter"
      },
      "maxItems": 256,
      "title": "Parameters",
      "type": "array"
    },
    "randomness": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RandomnessControl"
      },
      "maxItems": 128,
      "title": "Randomness",
      "type": "array"
