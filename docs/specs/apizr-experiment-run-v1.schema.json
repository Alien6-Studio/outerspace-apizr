          "type": "string"
        },
        "origin": {
          "const": "runtime",
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "code",
        "origin"
      ],
      "title": "RunDiagnostic",
      "type": "object"
    },
    "RunTiming": {
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "origin": {
          "const": "runtime",
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "origin"
      ],
      "title": "RunTiming",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "python",
            "notebook"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "executable_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Digest"
        },
        "module": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "capability_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\s/\\\\]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        }
      },
      "required": [
        "kind",
        "reference",
        "digest"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "apizr.experiment-run/v1",
      "default": "apizr.experiment-run/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "observed_inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InputArtifact"
      },
      "maxItems": 256,
      "title": "Observed Inputs",
      "type": "array"
    },
    "effective_parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Parameter"
      },
      "maxItems": 256,
      "title": "Effective Parameters",
      "type": "array"
    },
    "randomness": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RandomnessControl"
      },
      "maxItems": 128,
      "title": "Randomness",
      "type": "array"
    },
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "maxItems": 256,
      "title": "Metrics",
      "type": "array"
    },
    "outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutputArtifact"
      },
      "maxItems": 256,
      "title": "Outputs",
      "type": "array"
    },
    "timing": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunTiming"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RunDiagnostic"
      },
      "maxItems": 32,
      "title": "Diagnostics",
      "type": "array"
    }
  },
  "required": [
    "plan_digest",
    "subject",
    "status"
  ],
  "title": "ExperimentRun",
  "type": "object"
}
