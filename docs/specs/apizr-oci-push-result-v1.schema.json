{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "proof_requirement": {
      "anyOf": [
        {
          "enum": [
            "optional",
            "required"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proof Requirement"
    },
    "transfer_verified": {
      "anyOf": [
        {
          "const": true,
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transfer Verified"
    },
    "destination_promoted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination Promoted"
    },
    "delivery_admitted": {
      "anyOf": [
        {
          "const": false,
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Admitted"
    },
    "delivery_plan_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "delivery_manifest_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "const": "apizr.oci-push-result/v1",
      "default": "apizr.oci-push-result/v1",
      "title": "Schema",
      "type": "string"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "digest_reference": {
      "title": "Digest Reference",
      "type": "string"
    },
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "image_id": {
      "title": "Image Id",
      "type": "string"
    },
    "config_digest": {
      "title": "Config Digest",
      "type": "string"
    },
    "manifest_digest": {
      "title": "Manifest Digest",
      "type": "string"
    },
    "index_digest": {
      "default": null,
      "title": "Index Digest",
      "type": "null"
    },
    "inputs_sha256": {
      "title": "Inputs Sha256",
      "type": "string"
    },
    "published": {
      "const": true,
      "default": true,
      "title": "Published",
      "type": "boolean"
    }
  },
  "required": [
    "destination",
    "digest_reference",
    "platform",
    "image_id",
    "config_digest",
    "manifest_digest",
    "inputs_sha256"
  ],
  "title": "PushResult",
  "type": "object"
}
