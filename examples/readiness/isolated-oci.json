{
  "schema_version": "apizr.repository-readiness-policy/v1",
  "execution": {
    "modes": [
      "direct",
      "local-process",
      "oci-container"
    ],
    "require_controls": [
      "network_deny",
      "filesystem_sandbox",
      "memory_limit",
      "cpu_limit",
      "pid_limit"
    ]
  }
}
