{
  "$defs": {
    "CaptureIdentity": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/CaptureMode"
        },
        "producer": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/FunctionBinding",
          "default": {
            "module": null,
            "qualified_name": null,
            "definition_id": null,
            "source_digest": null,
            "origin": "unknown"
          }
        },
        "cell": {
          "$ref": "#/$defs/CellIdentity",
          "default": {
            "cell_id": null,
            "execution_count": null,
            "source_digest": null,
            "origin": "unknown"
          }
        },
        "selected_parameters": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Selected Parameters",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "producer",
        "producer_version"
      ],
      "title": "CaptureIdentity",
      "type": "object"
    },
    "CaptureMode": {
      "enum": [
        "cli_run",
        "sdk_session",
        "decorated_call",
        "jupyter_cell",
        "unknown"
      ],
      "title": "CaptureMode",
      "type": "string"
    },
    "CellIdentity": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        },
        "execution_count": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Count"
        },
        "source_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Digest"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "runtime",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "title": "CellIdentity",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "description": "Digest algorithm identifier, currently fixed to SHA-256 (sha256).",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "description": "The 64-character lowercase hexadecimal SHA-256 digest value, without an algorithm prefix.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "FunctionBinding": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "qualified_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualified Name"
        },
        "definition_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Id"
        },
        "source_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Digest"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "runtime",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "title": "FunctionBinding",
      "type": "object"
    },
    "OutputArtifact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "origin": {
          "const": "runtime",
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest",
        "origin"
      ],
      "title": "OutputArtifact",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "description": "A source identity is absent when no source bytes have been observed.",
      "properties": {
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "runtime",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "title": "SourceEvidence",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "python",
            "notebook"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "executable_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Digest"
        },
        "module": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "capability_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[^\\s/\\\\]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        }
      },
      "required": [
        "kind",
        "reference",
        "digest"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Retain the observed SDK source separately from its selected static module.\n\nSource content is bound to the bundle; a static module name is not promoted\ninto runtime evidence. Unknown defining-code/executable evidence stays unknown.\nThe independent version keeps the published v1 schema and bytes frozen.",
  "properties": {
    "schema_version": {
      "const": "apizr.experiment-exposure/v2",
      "default": "apizr.experiment-exposure/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "run_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Digest",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "observed_source": {
      "$ref": "#/$defs/SourceEvidence"
    },
    "capture": {
      "$ref": "#/$defs/CaptureIdentity"
    },
    "repository_digest": {
      "$ref": "#/$defs/Digest"
    },
    "catalog_digest": {
      "$ref": "#/$defs/Digest"
    },
    "graph_digest": {
      "$ref": "#/$defs/Digest"
    },
    "repository_readiness_digest": {
      "$ref": "#/$defs/Digest"
    },
    "exposure_plan_digest": {
      "$ref": "#/$defs/Digest"
    },
    "repository_interface_digest": {
      "$ref": "#/$defs/Digest"
    },
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "interface": {
      "enum": [
        "rest",
        "mcp"
      ],
      "title": "Interface",
      "type": "string"
    },
    "outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutputArtifact"
      },
      "maxItems": 128,
      "title": "Outputs",
      "type": "array"
    },
    "dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Dependencies",
      "type": "array"
    },
    "application_inputs_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_digest",
    "plan_digest",
    "source",
    "observed_source",
    "capture",
    "repository_digest",
    "catalog_digest",
    "graph_digest",
    "repository_readiness_digest",
    "exposure_plan_digest",
    "repository_interface_digest",
    "capability",
    "interface"
  ],
  "title": "ExperimentExposureBindingV2",
  "type": "object"
}
