        "exposure_plan_digest": {
          "$ref": "#/$defs/Digest"
        },
        "interface": {
          "$ref": "#/$defs/InvocationContract"
        },
        "interface_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy": {
          "$ref": "#/$defs/ExecutionPolicy"
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "repository_interface": {
          "$ref": "#/$defs/RepositoryInterface"
        },
        "repository_interface_digest": {
          "$ref": "#/$defs/Digest"
        },
        "schema_version": {
          "const": "apizr.repository-runtime/v1",
          "default": "apizr.repository-runtime/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_universe_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "repository_interface",
        "repository_interface_digest",
        "exposure_plan_digest",
        "source_universe_digest",
        "capability_id",
        "interface",
        "interface_digest",
        "effects",
        "policy",
        "policy_digest"
      ],
      "title": "RepositoryRuntimePlan",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "cpu_millis": {
          "default": 1000,
          "maximum": 64000,
          "minimum": 10,
          "title": "Cpu Millis",
          "type": "integer"
        },
        "memory_bytes": {
          "default": 268435456,
          "maximum": 8589934592,
          "minimum": 67108864,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "pids": {
          "default": 64,
          "maximum": 1024,
          "minimum": 8,
          "title": "Pids",
          "type": "integer"
        },
        "scratch_bytes": {
          "default": 16777216,
          "maximum": 1073741824,
          "minimum": 1048576,
          "title": "Scratch Bytes",
          "type": "integer"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "RuntimeImage": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ],
          "title": "Platform",
          "type": "string"
        },
        "provider": {
          "const": "apizr.docker-engine/v1",
          "default": "apizr.docker-engine/v1",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "image",
        "platform"
      ],
      "title": "RuntimeImage",
      "type": "object"
    },
    "Subprocess": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "allow",
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Subprocess",
      "type": "object"
    },
    "TypeSpec": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TypeSpec"
          },
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "enum": [
            "any",
            "int",
            "str",
            "float",
            "bool",
            "null",
            "list",
            "dict",
            "tuple",
            "set",
            "union",
            "literal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        },
        "variadic": {
          "default": false,
          "title": "Variadic",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "TypeSpec",
      "type": "object"
    },
    "apizr__capabilities__model__Effects": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "$ref": "#/$defs/Effect"
        },
        "external_service": {
          "$ref": "#/$defs/Effect"
        },
        "filesystem_read": {
          "$ref": "#/$defs/Effect"
        },
        "filesystem_write": {
          "$ref": "#/$defs/Effect"
        },
        "network": {
          "$ref": "#/$defs/Effect"
        },
        "secrets": {
          "$ref": "#/$defs/Effect"
        },
        "state_mutation": {
          "$ref": "#/$defs/Effect"
        },
        "subprocess": {
          "$ref": "#/$defs/Effect"
        }
      },
      "title": "Effects",
      "type": "object"
    },
    "apizr__execution__policy__Effects": {
      "additionalProperties": false,
      "properties": {
        "require_known": {
          "default": [],
          "items": {
            "enum": [
              "filesystem_read",
              "filesystem_write",
              "network",
              "environment",
              "subprocess",
              "state_mutation",
              "secrets",
              "external_service"
            ],
            "type": "string"
          },
          "title": "Require Known",
          "type": "array"
        }
      },
      "title": "Effects",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "backend_version": {
      "const": "apizr.oci-container/v1",
      "default": "apizr.oci-container/v1",
      "title": "Backend Version",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/ExecutionPolicyV2"
    },
    "policy_digest": {
      "$ref": "#/$defs/Digest"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeImage"
    },
    "schema_version": {
      "const": "apizr.repository-runtime/v2",
      "default": "apizr.repository-runtime/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "worker": {
      "$ref": "#/$defs/RepositoryRuntimePlan"
    },
    "worker_digest": {
      "$ref": "#/$defs/Digest"
    }
  },
  "required": [
    "policy",
    "policy_digest",
    "runtime",
    "worker",
    "worker_digest"
  ],
  "title": "RepositoryContainerPlan",
  "type": "object"
}
