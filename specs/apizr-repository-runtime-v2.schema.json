          "type": "string"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "effects": {
          "$ref": "#/$defs/apizr__capabilities__model__Effects"
        },
        "execution_context": {
          "default": "local-process",
          "enum": [
            "local-process",
            "oci-container"
          ],
          "title": "Execution Context",
          "type": "string"
