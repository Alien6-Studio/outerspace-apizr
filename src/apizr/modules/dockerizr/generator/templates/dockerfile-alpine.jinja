FROM python:{{ python_version }}-{{ docker_image_tag }}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
{% if dependencies %}
RUN apk add --no-cache {{ dependencies | join(' ') }}
{% endif %}
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN addgroup -g 10001 apizr && adduser -D -u 10001 -G apizr apizr
COPY --chown=apizr:apizr . .
RUN chmod +x /app/start.sh
USER apizr
EXPOSE {{ port }}
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ port }}/health', timeout=2)" || exit 1
ENTRYPOINT ["/app/start.sh"]
