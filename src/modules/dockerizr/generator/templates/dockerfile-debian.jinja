FROM python:{{ python_version }}-{{ docker_image_tag }}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
{% if dependencies %}
RUN apt-get update && apt-get install -y --no-install-recommends {{ dependencies | join(' ') }} && rm -rf /var/lib/apt/lists/*
{% endif %}
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN groupadd --gid 10001 apizr && useradd --uid 10001 --gid apizr --create-home apizr
COPY --chown=apizr:apizr . .
RUN chmod +x /app/start.sh
USER apizr
EXPOSE {{ port }}
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ port }}/health', timeout=2)" || exit 1
ENTRYPOINT ["/app/start.sh"]
